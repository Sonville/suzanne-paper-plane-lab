    /* =========================================================================
       9. 發射紙飛機 (真實破空高速動力學與長程滑翔)
       ========================================================================= */
    function launchAirplane() {
      if (State.isFlying) return;

      AudioEngine.playLaunchWhoosh();

      // 彈射架回彈動畫
      if (State.enableLauncher && State.launcherType === 'slingshot' && elasticBandMesh) {
        elasticBandMesh.scale.set(0.1, 1, 0.1);
        setTimeout(() => {
          if (elasticBandMesh) elasticBandMesh.scale.set(1, 1, 1);
        }, 220);
      }

      State.isFlying = true;
      State.isLanded = false;
      State.flightTime = 0;
      State.flightDistance = 0;
      State.maxAlt = State.pos.y;
      State.pitchRate = 0;
      ribbonPoints.length = 0;
      tipLeftPoints.length = 0;
      tipRightPoints.length = 0;

      State.isCloseUp = false;
      if (State.camMode !== 'side' && State.camMode !== 'tower') {
        switchCamMode('chase');
      }

      // 初始仰角與發射初速度 (-Z 為正前方)
      const pitchRad = THREE.MathUtils.degToRad(State.launchPitch);
      State.flightPathAngle = pitchRad; // 初始航跡傾角
      State.bodyPitchAngle = pitchRad + 0.035; // 初始迎風攻角微抬，絕對不栽頭

      // 充沛的真實甩擲初速度 (13.5m/s ~ 22m/s)
      let initialV = State.launchSpeed;
      if (State.enableLauncher && State.launcherType === 'slingshot') {
        initialV += State.elasticTension * 7.5; // 彈射器蓄能加乘
      }
      initialV = Math.max(initialV, 5.0);
      initialV = Math.min(initialV, 35.0);
      State.glideSpeed = initialV;

      // 速度向量分解：-Z 為前方，+Y 為上方
      const vz = -Math.cos(pitchRad) * initialV;
      const vy = Math.sin(pitchRad) * initialV;
      State.vel.set(0, vy, vz);

      // 防穿模發射微偏移
      const minSafeFloor = computeAirplaneClearanceOffset() + 0.05;
      if (State.pos.y < minSafeFloor) {
        State.pos.y = minSafeFloor;
      }
      airplaneRoot.position.copy(State.pos);

      // 動態對焦相機至後方
      if (State.camMode === 'chase') {
        camera.position.set(State.pos.x, State.pos.y + 0.8, State.pos.z + 3.2);
        controls.target.copy(State.pos);
      }

      document.getElementById('hud-flight-state').textContent = '飛行中';
      document.getElementById('hud-flight-state').className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono font-bold';
      document.getElementById('status-indicator').textContent = '飛行進行中 | 穩定滑翔中';
    }

    /* =========================================================================
       10. 空氣動力學物理更新迴圈 (極致滑翔升力 + 月球純真空彈道物理)
       ========================================================================= */
    function updateFlightPhysics(dt) {
      if (!State.isFlying || State.isLanded) return;

      const step = Math.min(Math.max(dt, 0.001), 0.035);
      State.flightTime += step;

      // 安全防護：若出現無效數值則平穩復原
      if (isNaN(State.glideSpeed) || isNaN(State.pos.x) || isNaN(State.pos.y) || isNaN(State.pos.z)) {
        State.pos.set(0, computeAirplaneClearanceOffset(), 0);
        touchdown();
        return;
      }

      // -----------------------------------------------------------------
      // 【真實月球真空彈道模式 (Pure Ballistic Trajectory, No Atmosphere)】
      // -----------------------------------------------------------------
      if (State.airDensity <= 0.001) {
        State.vel.y += State.gravity * step;
        State.pos.addScaledVector(State.vel, step);
        airplaneRoot.position.copy(State.pos);

        // 姿態：維持發射俯仰角
        const pitchQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), State.bodyPitchAngle);
        airplaneRoot.quaternion.copy(pitchQuat);

        State.flightDistance = Math.hypot(State.pos.x, State.pos.z);
        if (State.pos.y > State.maxAlt) State.maxAlt = State.pos.y;

        updateFlightTrails();

        const groundClearance = computeAirplaneClearanceOffset();
        if (State.pos.y <= groundClearance) {
          State.pos.y = groundClearance;
          airplaneRoot.position.y = groundClearance;
          touchdown();
        }

        updateTelemetryHUD(State.vel.length(), State.pos.y, State.flightDistance, 0.0, '0.0 (真空)');
        return;
      }

      // -----------------------------------------------------------------
      // 【地球大氣環境：真實滑翔動力學 (Realistic Glider Dynamics)】
      // -----------------------------------------------------------------
      // 1. 機型氣動參數定義
      let baseWingArea = 0.038;
      let baseCd0 = 0.022;
      let aspectRatio = 4.5;

      if (State.model === 'glider') {
        baseWingArea = 0.055;
        baseCd0 = 0.016;
        aspectRatio = 6.2;
      } else if (State.model === 'falcon') {
        baseWingArea = 0.034;
        baseCd0 = 0.018;
        aspectRatio = 4.0;
      } else if (State.model === 'shuttle') {
        baseWingArea = 0.045;
        baseCd0 = 0.045;
        aspectRatio = 2.8;
      }

      const wingArea = baseWingArea * (State.planeScale * State.planeScale);
      const baseMass = 0.0050; // 5g
      const totalMass = baseMass + State.clipCount * 0.0012; // 每個迴紋針 1.2g

      // 2. 配平攻角與升阻力計算
      const elevonTrimRad = THREE.MathUtils.degToRad(State.elevonAngle);
      const clipStabilizer = 1.0 + State.clipCount * 0.18;
      // 自然滑翔配平攻角 (典型在 2.5° ~ 6.5° 之間)
      const trimAoARad = THREE.MathUtils.clamp((0.048 + elevonTrimRad * 0.12) / clipStabilizer, -0.02, 0.14);

      // 升力係數 CL
      const Cl = THREE.MathUtils.clamp(0.24 + 3.2 * trimAoARad, 0.05, 0.88);
      // 翼尖小翼減阻
      const wingletFactor = Math.max(0.72, 1.0 - (State.wingletAngle / 80) * 0.28);
      // 誘導阻力 CDi = CL^2 / (pi * AR * e)
      const inducedDrag = (Cl * Cl) / (Math.PI * aspectRatio * 0.82) * wingletFactor;
      // 摩擦與壓差阻力 (表面粗糙度影響)
      const skinDrag = baseCd0 * (1.0 + (State.roughness - 0.5) * 0.2);
      const elevonDrag = Math.pow(Math.sin(Math.max(0, elevonTrimRad)), 2) * 0.15;
      const Cd = skinDrag + inducedDrag + elevonDrag;

      // 滑降比 L/D
      const glideRatio = THREE.MathUtils.clamp(Cl / Math.max(Cd, 0.012), 4.5, 14.5);
      const naturalSinkSlope = -Math.atan(1.0 / glideRatio);

      // 3. 航跡傾角平滑過渡 (起飛階段 -> 穩定滑翔)
      let targetFlightSlope;
      if (State.flightTime < 0.8) {
        // 發射後前 0.8 秒平滑過渡，消除初始向下沉頭
        const initialSlope = THREE.MathUtils.degToRad(State.launchPitch);
        const t = Math.min(1.0, State.flightTime / 0.8);
        const smoothT = t * t * (3 - 2 * t); // smoothstep
        targetFlightSlope = THREE.MathUtils.lerp(initialSlope, naturalSinkSlope, smoothT);
      } else {
        targetFlightSlope = naturalSinkSlope;
      }

      // 一階過阻尼濾波器更新航跡角 (杜絕上下波浪跳動)
      State.flightPathAngle = THREE.MathUtils.lerp(State.flightPathAngle, targetFlightSlope, step * 2.8);

      // 4. 前向滑翔速度衰減計算 (基於真實阻力做功)
      const q = 0.5 * State.airDensity * (State.glideSpeed * State.glideSpeed);
      const dragForce = q * wingArea * Cd;
      // 阻力減速 (只由阻力消耗速度，重力對航跡的影響已在航跡傾角中體現)
      const speedDecel = dragForce / totalMass;
      State.glideSpeed -= speedDecel * step;
      // 允許降至真實失速速度 (1.8 m/s)
      State.glideSpeed = Math.max(State.glideSpeed, 1.8);

      // 5. 速度向量分解 (朝向 -Z 正前方滑行)
      let forwardH = Math.cos(State.flightPathAngle) * State.glideSpeed;
      let verticalV = Math.sin(State.flightPathAngle) * State.glideSpeed;

      // 6. 地面效應氣墊 (Ground Effect Cushion: 距地 0.5m 內顯著降低下沉率)
      if (State.pos.y < 0.6 && State.flightTime > 0.4) {
        const cushion = Math.max(0, (0.6 - State.pos.y) / 0.6);
        verticalV *= (1.0 - cushion * 0.65); // 減少下沉速度
        forwardH *= (1.0 + cushion * 0.12);  // 貼地滑行維持前進
      }

      State.vel.set(0, verticalV, -forwardH);
      State.pos.addScaledVector(State.vel, step);
      airplaneRoot.position.copy(State.pos);

      State.flightDistance = Math.hypot(State.pos.x, State.pos.z);
      if (State.pos.y > State.maxAlt) State.maxAlt = State.pos.y;

      // 7. 機身視覺姿態：對齊航跡角 + 平滑攻角 (保證機頭始終微昂破空)
      const targetBodyPitch = State.flightPathAngle + trimAoARad;
      State.bodyPitchAngle = THREE.MathUtils.lerp(State.bodyPitchAngle, targetBodyPitch, step * 6.0);
      const pitchQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), State.bodyPitchAngle);
      airplaneRoot.quaternion.copy(pitchQuat);

      updateFlightTrails();

      // 8. 著陸檢測 (只有真正接觸地面時才停止)
      const groundClearance = computeAirplaneClearanceOffset();
      if (State.flightTime > 0.25 && State.pos.y <= groundClearance) {
        State.pos.y = groundClearance;
        airplaneRoot.position.y = groundClearance;
        touchdown();
      }

      const aoaDeg = THREE.MathUtils.radToDeg(trimAoARad);
      updateTelemetryHUD(State.glideSpeed, State.pos.y, State.flightDistance, aoaDeg, glideRatio.toFixed(1));
    }

    function updateFlightTrails() {
      ribbonPoints.push(State.pos.clone());
      if (ribbonPoints.length > ribbonMaxPoints) ribbonPoints.shift();
      ribbonGeo.setFromPoints(ribbonPoints);

      const spanHalf = 0.24 * State.planeScale;
      const leftTip = State.pos.clone().add(new THREE.Vector3(-spanHalf, 0, 0).applyQuaternion(airplaneRoot.quaternion));
      const rightTip = State.pos.clone().add(new THREE.Vector3(spanHalf, 0, 0).applyQuaternion(airplaneRoot.quaternion));
      tipLeftPoints.push(leftTip);
      tipRightPoints.push(rightTip);
      if (tipLeftPoints.length > 50) tipLeftPoints.shift();
      if (tipRightPoints.length > 50) tipRightPoints.shift();
      tipGeoL.setFromPoints(tipLeftPoints);
      tipGeoR.setFromPoints(tipRightPoints);
    }

    function touchdown() {
      State.isFlying = false;
      State.isLanded = true;
      State.vel.set(0, 0, 0);

      document.getElementById('hud-flight-state').textContent = '已著陸';
      document.getElementById('hud-flight-state').className = 'text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 font-mono font-bold';
      document.getElementById('status-indicator').textContent = `著陸完成 | 總滑翔航程: ${State.flightDistance.toFixed(2)}m | 最高高度: ${State.maxAlt.toFixed(2)}m`;
    }

    function resetAirplane() {
      State.isFlying = false;
      State.isLanded = false;
      State.flightTime = 0;
      State.flightDistance = 0;
      State.vel.set(0, 0, 0);

      updateAirplaneClearance();
      airplaneRoot.quaternion.identity();

      ribbonPoints.length = 0;
      ribbonGeo.setFromPoints([]);
      tipLeftPoints.length = 0;
      tipRightPoints.length = 0;
      tipGeoL.setFromPoints([]);
      tipGeoR.setFromPoints([]);

      State.isCloseUp = false;
      switchCamMode('chase');

      document.getElementById('hud-flight-state').textContent = '停靠待命';
      document.getElementById('hud-flight-state').className = 'text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-mono';
      document.getElementById('status-indicator').textContent = '準備發射 | 調整參數後按空白鍵或發射鈕';
      updateTelemetryHUD(0, State.pos.y, 0, 0, '0.0');
    }

    function updateTelemetryHUD(v, alt, dist, aoa, ld) {
      document.getElementById('hud-speed').textContent = `${Math.max(0, v).toFixed(1)} m/s`;
      document.getElementById('hud-alt').textContent = `${Math.max(0, alt).toFixed(1)} m`;
      document.getElementById('hud-dist').textContent = `${dist.toFixed(1)} m`;
      document.getElementById('hud-aoa').textContent = `${aoa >= 0 ? '+' : ''}${aoa.toFixed(1)}°`;
      document.getElementById('hud-ld').textContent = `${ld} : 1`;
    }

    /* =========================================================================
       11. 智慧多模式運鏡導演 (特寫插值、側面觀測、追蹤、360度自由環繞)
       ========================================================================= */
    function updateCameraDirector(dt) {
      if (State.isCloseUp) {
        camera.position.lerp(State.closeUpCamPos, 0.08);
        controls.target.lerp(State.closeUpTarget, 0.08);
        return;
      }

      if (isNaN(State.pos.x) || isNaN(State.pos.y) || isNaN(State.pos.z)) return;

      if (State.isFlying || State.isLanded) {
        if (State.camMode === 'chase') {
          // 動態追逐攝影機：增加透視距離感與流暢彈性追隨 (帶出呼嘯破空的速度感)
          const chaseOffset = new THREE.Vector3(0, 0.95, 3.4);
          const targetCamPos = State.pos.clone().add(chaseOffset);

          if (targetCamPos.y < 0.35) targetCamPos.y = 0.35;

          camera.position.lerp(targetCamPos, 0.12);
          controls.target.lerp(State.pos, 0.18);

        } else if (State.camMode === 'orbit') {
          // 自由環繞：保留玩家手動拖曳設定之球座標角度，平移跟隨飛機
          const delta = State.pos.clone().sub(controls.target);
          camera.position.add(delta);
          controls.target.copy(State.pos);

        } else if (State.camMode === 'side') {
          // 側面觀測：橫向鎖定機身側面 (+X 偏移)
          const sideOffset = new THREE.Vector3(4.2, 0.4, 0);
          const targetCamPos = State.pos.clone().add(sideOffset);
          if (targetCamPos.y < 0.35) targetCamPos.y = 0.35;
          camera.position.lerp(targetCamPos, 0.12);
          controls.target.lerp(State.pos, 0.16);

        } else if (State.camMode === 'tower') {
          // 地面固定瞭望塔
          const towerPos = new THREE.Vector3(4.0, State.initialAltitude + 1.8, 4.0);
          camera.position.lerp(towerPos, 0.05);
          controls.target.lerp(State.pos, 0.10);
        }
      }
    }

    function switchCamMode(mode) {
      State.camMode = mode;
      State.isCloseUp = false;

      // 更新頂部按鈕高亮
      ['chase', 'side', 'orbit'].forEach(m => {
        const btn = document.getElementById(`cam-${m}`);
        if (!btn) return;
        if (m === mode) {
          btn.className = 'px-3 py-1.5 rounded-xl text-xs font-medium flex items-center space-x-1.5 transition-all bg-cyan-500/20 text-cyan-300 border border-cyan-500/40';
        } else {
          btn.className = 'px-3 py-1.5 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 flex items-center space-x-1.5 transition-all';
        }
      });
    }

    function triggerCloseUp(targetOffset, camOffset) {
      State.isCloseUp = true;
      State.closeUpTarget.copy(State.pos).add(targetOffset);
      State.closeUpCamPos.copy(State.pos).add(camOffset);
    }

    /* =========================================================================
       12. 使用者介面互動與事件綁定 (UI Event Listeners)
       ========================================================================= */
    function initUI() {
      // 標籤頁切換
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('text-cyan-300', 'bg-slate-800/90');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('text-cyan-300', 'bg-slate-800/90');
          btn.classList.remove('text-slate-400');

          document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
          const target = btn.dataset.tab;
          document.getElementById(target).classList.remove('hidden');
        });
      });

      // 機型切換
      document.querySelectorAll('.model-select-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.model-select-btn').forEach(b => {
            b.className = 'model-select-btn p-2 rounded-xl text-left border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500';
          });
          btn.className = 'model-select-btn p-2 rounded-xl text-left border border-cyan-500/50 bg-cyan-950/30 text-cyan-300';
          State.model = btn.dataset.model;
          AudioEngine.playPaperCrease();
          buildOrigamiModel();
        });
      });

      // 迴紋針數量切換
      document.querySelectorAll('.clip-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.clip-btn').forEach(b => {
            b.className = 'clip-btn py-1 rounded-lg text-xs font-medium border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500';
          });
          btn.className = 'clip-btn py-1 rounded-lg text-xs font-bold border border-amber-500 bg-amber-500/20 text-amber-300';
          State.clipCount = parseInt(btn.dataset.clips, 10);
          clipMeshes.forEach((mesh, idx) => {
            mesh.visible = idx < State.clipCount;
          });
          document.getElementById('val-clip-weight').textContent = `${(State.clipCount * 1.1).toFixed(1)}g`;
          document.getElementById('val-clip-margin').textContent = `+${11 + State.clipCount * 4}%`;
          AudioEngine.playClipSnap();
          updateAirplaneClearance();
        });
      });

      // 尾舵滑桿
      const sliderElevon = document.getElementById('slider-elevon');
      sliderElevon.addEventListener('input', (e) => {
        State.elevonAngle = parseFloat(e.target.value);
        document.getElementById('val-elevon').textContent = `${State.elevonAngle >= 0 ? '+' : ''}${State.elevonAngle}°`;
        applyWingAngles();
      });

      // 上反角滑桿
      const sliderDihedral = document.getElementById('slider-dihedral');
      sliderDihedral.addEventListener('input', (e) => {
        State.dihedralAngle = parseFloat(e.target.value);
        document.getElementById('val-dihedral').textContent = `${State.dihedralAngle >= 0 ? '+' : ''}${State.dihedralAngle}°`;
        applyWingAngles();
        updateAirplaneClearance();
      });

      // 翼尖小翼滑桿
      const sliderWinglet = document.getElementById('slider-winglet');
      sliderWinglet.addEventListener('input', (e) => {
        State.wingletAngle = parseFloat(e.target.value);
        document.getElementById('val-winglet').textContent = `${State.wingletAngle}°`;
        applyWingAngles();
      });

      // 粗糙度滑桿
      const sliderRoughness = document.getElementById('slider-roughness');
      sliderRoughness.addEventListener('input', (e) => {
        State.roughness = parseFloat(e.target.value);
        document.getElementById('val-roughness').textContent = State.roughness.toFixed(2);
        paperMat.roughness = State.roughness;
      });

      // 模型尺寸放大滑桿
      const sliderScale = document.getElementById('slider-scale');
      sliderScale.addEventListener('input', (e) => {
        State.planeScale = parseFloat(e.target.value);
        document.getElementById('val-scale').textContent = `${State.planeScale.toFixed(1)}x`;
        applyWingAngles();
        updateAirplaneClearance();
      });

      // 骨刀壓痕動畫
      document.getElementById('btn-crease-anim').addEventListener('click', () => {
        AudioEngine.playPaperCrease();
        triggerCloseUp(new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 0.45, 0.65));
      });

      // 特寫按鈕監聽
      document.getElementById('focus-overview').addEventListener('click', () => {
        triggerCloseUp(new THREE.Vector3(0, 0, 0), new THREE.Vector3(0.5, 0.7, 0.9));
      });
      document.getElementById('focus-nose').addEventListener('click', () => {
        triggerCloseUp(new THREE.Vector3(0, 0, -0.35), new THREE.Vector3(0, 0.25, -0.1));
      });
      document.getElementById('focus-tail').addEventListener('click', () => {
        triggerCloseUp(new THREE.Vector3(0, 0, 0.18), new THREE.Vector3(0, 0.35, 0.65));
      });
      document.getElementById('focus-front').addEventListener('click', () => {
        triggerCloseUp(new THREE.Vector3(0, 0, -0.2), new THREE.Vector3(0, 0.05, -0.85));
      });
      document.getElementById('focus-wingtip').addEventListener('click', () => {
        triggerCloseUp(new THREE.Vector3(0.24, 0, 0.16), new THREE.Vector3(0.55, 0.2, 0.35));
      });

      // 發射台裝備開關
      document.getElementById('chk-launcher').addEventListener('change', (e) => {
        State.enableLauncher = e.target.checked;
        buildLauncher();
      });

      // 發射機構類型
      document.querySelectorAll('.launcher-type-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.launcher-type-btn').forEach(b => {
            b.className = 'launcher-type-btn p-2 rounded-xl text-center border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500';
          });
          btn.className = 'launcher-type-btn p-2 rounded-xl text-center border border-emerald-500/50 bg-emerald-950/30 text-emerald-300';
          State.launcherType = btn.dataset.launcher;
          buildLauncher();
        });
      });

      // 初始高度滑桿
      const sliderAlt = document.getElementById('slider-altitude');
      sliderAlt.addEventListener('input', (e) => {
        State.initialAltitude = parseFloat(e.target.value);
        document.getElementById('val-altitude').textContent = `${State.initialAltitude.toFixed(1)} m`;
        updateAirplaneClearance();
        buildLauncher();
      });

      // 初始高度快選
      document.querySelectorAll('.alt-preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = parseFloat(btn.dataset.alt);
          State.initialAltitude = val;
          sliderAlt.value = val;
          document.getElementById('val-altitude').textContent = `${val.toFixed(1)} m`;
          updateAirplaneClearance();
          buildLauncher();
        });
      });

      // 橡皮筋張力與速度
      document.getElementById('slider-tension').addEventListener('input', (e) => {
        State.elasticTension = parseInt(e.target.value, 10) / 100;
        document.getElementById('val-tension').textContent = `${e.target.value}%`;
      });
      document.getElementById('slider-speed').addEventListener('input', (e) => {
        State.launchSpeed = parseFloat(e.target.value);
        document.getElementById('val-speed').textContent = `${State.launchSpeed.toFixed(1)} m/s`;
      });
      document.getElementById('slider-pitch').addEventListener('input', (e) => {
        State.launchPitch = parseInt(e.target.value, 10);
        document.getElementById('val-pitch').textContent = `${State.launchPitch >= 0 ? '+' : ''}${State.launchPitch}°`;
      });

      // 生態環境切換
      document.querySelectorAll('.biome-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.biome-btn').forEach(b => {
            b.className = 'biome-btn p-2.5 rounded-xl text-left border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500 flex items-center justify-between transition-all';
            const check = b.querySelector('.biome-check');
            if (check) check.classList.add('hidden');
          });
          btn.className = 'biome-btn p-2.5 rounded-xl text-left border border-cyan-500/50 bg-cyan-950/30 text-cyan-200 flex items-center justify-between transition-all';
          const currentCheck = btn.querySelector('.biome-check');
          if (currentCheck) currentCheck.classList.remove('hidden');

          State.biome = btn.dataset.biome;
          buildBiomeEnvironment();
        });
      });

      // 視角切換監聽
      document.getElementById('cam-chase').addEventListener('click', () => switchCamMode('chase'));
      document.getElementById('cam-side').addEventListener('click', () => switchCamMode('side'));
      document.getElementById('cam-orbit').addEventListener('click', () => switchCamMode('orbit'));

      // 發射與重置
      document.getElementById('btn-launch-main').addEventListener('click', launchAirplane);
      document.getElementById('btn-launch-top').addEventListener('click', launchAirplane);
      document.getElementById('btn-reset-main').addEventListener('click', resetAirplane);
      document.getElementById('btn-reset-top').addEventListener('click', resetAirplane);

      // 空白鍵發射快捷
      window.addEventListener('keydown', (e) => {
        if (e.code === 'Space') {
          e.preventDefault();
          launchAirplane();
        } else if (e.code === 'KeyR') {
          resetAirplane();
        }
      });

      // 格式說明彈窗 (Modal)
      const modal = document.getElementById('spec-modal');
      const modalTitle = document.getElementById('modal-title');
      const modalBody = document.getElementById('modal-body');
      const modalClose = () => modal.classList.add('hidden');
      document.getElementById('modal-close').addEventListener('click', modalClose);
      document.getElementById('modal-confirm').addEventListener('click', modalClose);

      document.getElementById('btn-show-plane-spec').addEventListener('click', () => {
        modalTitle.textContent = '自訂紙飛機 3D 模型格式規範';
        modalBody.innerHTML = `
          <ul class="list-disc pl-4 space-y-1">
            <li><b>支援副檔名：</b> .glb, .gltf, .obj</li>
            <li><b>座標朝向標準：</b> 機首尖端必須嚴格朝向 <b>-Z 軸</b>，雙翼向兩側展開於 X 軸，垂直尾翼向上朝 +Y 軸。</li>
            <li><b>原點設定：</b> 請將幾何中心/重心放置於 (0, 0, 0)。系統載入時會自動進行等比縮放並正規化為 0.42m 長度。</li>
            <li><b>頂點與面數限制：</b> 建議於 500 ~ 5,000 面以內，以獲得流暢之 WebGL 60FPS 氣動力學運算。</li>
          </ul>
        `;
        modal.classList.remove('hidden');
      });

      document.getElementById('btn-show-env-spec').addEventListener('click', () => {
        modalTitle.textContent = '自訂 360° 全景環境貼圖規範';
        modalBody.innerHTML = `
          <ul class="list-disc pl-4 space-y-1">
            <li><b>支援格式：</b> .jpg, .png (8-bit sRGB)</li>
            <li><b>投影格式：</b> 360° 等距柱狀投影 (Equirectangular 2:1 寬高比，如 2048x1024 或 4096x2048)。</li>
            <li><b>功能效果：</b> 載入後自動映射至全景天空穹頂，提供沉浸式地平線與天幕光照環境。</li>
          </ul>
        `;
        modal.classList.remove('hidden');
      });

      document.getElementById('btn-show-obj-spec').addEventListener('click', () => {
        modalTitle.textContent = '批次地表 3D 物件散佈規範';
        modalBody.innerHTML = `
          <ul class="list-disc pl-4 space-y-1">
            <li><b>支援格式：</b> .glb, .gltf, .obj (支援多選一次載入)</li>
            <li><b>地面貼齊：</b> 系統會自動計算物體邊界盒 (BoundingBox)，並將底部平穩固定於 Y = 0 地表。</li>
            <li><b>避開航道：</b> 匯入之模型將有機隨機排列於中央發射滑翔跑道兩側，豐富環境景觀。</li>
          </ul>
        `;
        modal.classList.remove('hidden');
      });

      // 檔案上傳解析 (GLTFLoader & OBJLoader)
      const gltfLoader = new THREE.GLTFLoader();
      const objLoader = new THREE.OBJLoader();

      document.getElementById('file-plane').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const url = URL.createObjectURL(file);
        const ext = file.name.split('.').pop().toLowerCase();

        const onLoaded = (obj) => {
          while (airplaneRoot.children.length > 0) airplaneRoot.remove(airplaneRoot.children[0]);
          const bbox = new THREE.Box3().setFromObject(obj);
          const size = new THREE.Vector3();
          bbox.getSize(size);
          const maxDim = Math.max(size.x, size.y, size.z);
          const scale = 0.42 / maxDim;
          obj.scale.setScalar(scale);

          // 居中處理
          const center = new THREE.Vector3();
          bbox.getCenter(center);
          obj.position.sub(center.multiplyScalar(scale));

          airplaneRoot.add(obj);
          updateAirplaneClearance();
          AudioEngine.playPaperCrease();
          document.getElementById('status-indicator').textContent = `成功載入自訂飛機: ${file.name}`;
        };

        if (ext === 'glb' || ext === 'gltf') {
          gltfLoader.load(url, (gltf) => onLoaded(gltf.scene));
        } else if (ext === 'obj') {
          objLoader.load(url, onLoaded);
        }
      });

      // 全景圖上傳
      document.getElementById('file-env').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            const texture = new THREE.Texture(img);
            texture.mapping = THREE.EquirectangularReflectionMapping;
            texture.needsUpdate = true;
            scene.background = texture;
            scene.fog.density = 0.001;
            document.getElementById('status-indicator').textContent = `已切換全景環境背景: ${file.name}`;
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      });

      // 多物件批次上傳
      document.getElementById('file-objs').addEventListener('change', (e) => {
        const files = Array.from(e.target.files);
        if (!files.length) return;
        files.forEach((file) => {
          const url = URL.createObjectURL(file);
          const ext = file.name.split('.').pop().toLowerCase();
          const placeObj = (mesh) => {
            const side = Math.random() > 0.5 ? 1 : -1;
            const x = side * (5.0 + Math.random() * 40);
            const z = -10 - Math.random() * 220;
            mesh.position.set(x, 0, z);
            biomeGroup.add(mesh);
          };
          if (ext === 'glb' || ext === 'gltf') {
            gltfLoader.load(url, (gltf) => placeObj(gltf.scene));
          } else if (ext === 'obj') {
            objLoader.load(url, placeObj);
          }
        });
        document.getElementById('status-indicator').textContent = `成功散佈 ${files.length} 個自訂地景物件`;
      });
    }

    /* =========================================================================
       13. 動畫主渲染迴圈 (RequestAnimationFrame Loop)
       ========================================================================= */
    let lastTime = performance.now();

    function animate() {
      requestAnimationFrame(animate);

      const now = performance.now();
      const dt = (now - lastTime) / 1000;
      lastTime = now;

      // 1. 動態場景物體旋轉動畫 (風扇、風車等)
      for (let i = 0; i < dynamicAnimObjects.length; i++) {
        const item = dynamicAnimObjects[i];
        if (item.obj) {
          item.obj.rotation[item.axis] += item.speed * dt;
        }
      }

      // 2. 物理步進
      updateFlightPhysics(dt);

      // 3. 智慧鏡頭運鏡
      updateCameraDirector(dt);

      // 4. OrbitControls 平滑阻尼更新
      controls.update();

      // 5. WebGL 渲染
      renderer.render(scene, camera);
    }

    // 視窗自適應縮放
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // 啟動初始化
    window.onload = () => {
      lucide.createIcons();
      buildOrigamiModel();
      buildLauncher();
      buildBiomeEnvironment();
      initUI();
      animate();
    };
  </script>
