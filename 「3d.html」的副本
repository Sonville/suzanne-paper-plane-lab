  <!-- ========================================================================= -->
  <!-- 核心 JavaScript 邏輯：Three.js PBR 引擎 + 真實長距離空氣動力學物理模擬器 -->
  <!-- ========================================================================= -->
  <script>
    /* =========================================================================
       1. 狀態機與物理參數核心 (State)
       ========================================================================= */
    const State = {
      // Aircraft Geometry & Aerodynamics
      model: 'dart',
      elevonAngle: 2, // degrees
      dihedralAngle: 6, // degrees
      wingletAngle: 25, // degrees
      roughness: 0.65,
      planeScale: 1.2,
      clipCount: 0, // 0 to 5 clips

      // Launcher Specs
      enableLauncher: true,
      launcherType: 'slingshot',
      elasticTension: 1.0,
      initialAltitude: 1.6,
      launchPitch: 6, // degrees
      launchSpeed: 13.5, // 充沛的基準投擲力道 (13.5 m/s)

      // Environment & Biome Specs
      biome: 'lab',
      gravity: -9.81,
      airDensity: 1.225,

      // Flight Simulation Dynamics
      isFlying: false,
      isLanded: false,
      pos: new THREE.Vector3(0, 1.6, 0),
      vel: new THREE.Vector3(0, 0, 0),
      bodyPitchAngle: 0, // current pitch radians
      pitchRate: 0, // pitch angular velocity for damping
      smoothAoA: 0.05, // filtered angle of attack
      flightPathAngle: 0, // smooth gamma (flight trajectory angle)
      glideSpeed: 13.5, // scalar forward speed
      flightDistance: 0,
      maxAlt: 1.6,
      flightTime: 0,

      // Camera State
      camMode: 'chase', // 'chase', 'side', 'orbit', 'tower'
      isCloseUp: false,
      closeUpTarget: new THREE.Vector3(0, 1.6, 0),
      closeUpCamPos: new THREE.Vector3(0, 1.8, 2.5),
    };

    /* =========================================================================
       2. Web Audio API 音效合成引擎 (純數學合成，零外部依賴)
       ========================================================================= */
    const AudioEngine = {
      ctx: null,
      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) this.ctx = new AudioContext();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },
      playClipSnap() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(2400, now);
        osc.frequency.exponentialRampToValueAtTime(800, now + 0.08);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.09);
      },
      playPaperCrease() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const bufferSize = this.ctx.sampleRate * 0.15;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.3));
        }
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(1400, now);
        filter.Q.setValueAtTime(3.0, now);
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.35, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
        noise.connect(filter);
        filter.connect(gain);
        gain.connect(this.ctx.destination);
        noise.start(now);
      },
      playLaunchWhoosh() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(120, now);
        osc.frequency.exponentialRampToValueAtTime(420, now + 0.12);
        osc.frequency.exponentialRampToValueAtTime(80, now + 0.45);
        gain.gain.setValueAtTime(0.01, now);
        gain.gain.linearRampToValueAtTime(0.45, now + 0.1);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.46);
      }
    };

    /* =========================================================================
       3. Three.js 場景、PBR 燈光、渲染器與控制器初始化
       ========================================================================= */
    const canvas = document.getElementById('webgl-canvas');
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x060c18);
    scene.fog = new THREE.FogExp2(0x060c18, 0.002);

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 8000);
    camera.position.set(0, 2.2, 3.8);

    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.minDistance = 0.4;
    controls.maxDistance = 250;
    controls.maxPolarAngle = Math.PI / 2 - 0.01; // 不穿透地面
    controls.minAzimuthAngle = -Infinity; // 360 度無死角自由環繞
    controls.maxAzimuthAngle = Infinity;
    controls.target.set(0, 1.6, 0);

    // 燈光配置 (高科技 PBR 陰影柔光)
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.75);
    scene.add(ambientLight);

    const sunLight = new THREE.DirectionalLight(0xfff8ea, 1.8);
    sunLight.position.set(25, 45, 20);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 2048;
    sunLight.shadow.mapSize.height = 2048;
    sunLight.shadow.camera.near = 1;
    sunLight.shadow.camera.far = 160;
    const sD = 40;
    sunLight.shadow.camera.left = -sD;
    sunLight.shadow.camera.right = sD;
    sunLight.shadow.camera.top = sD;
    sunLight.shadow.camera.bottom = -sD;
    sunLight.shadow.bias = -0.0003;
    scene.add(sunLight);

    const fillLight = new THREE.DirectionalLight(0x38bdf8, 0.45);
    fillLight.position.set(-20, 15, -20);
    scene.add(fillLight);

    /* =========================================================================
       4. Procedural Canvas PBR 地面材質生成器 (沙浪、地磚、草絲、瀝青電路、月球粉塵)
       ========================================================================= */
    function generateFloorTexture(biome) {
      const cvs = document.createElement('canvas');
      cvs.width = 1024;
      cvs.height = 1024;
      const ctx = cvs.getContext('2d');

      if (biome === 'desert') {
        // 沙漠：正弦沙浪波紋
        ctx.fillStyle = '#b45309';
        ctx.fillRect(0, 0, 1024, 1024);
        for (let y = 0; y < 1024; y += 4) {
          const alpha = 0.12 + Math.sin(y * 0.065) * 0.08;
          ctx.fillStyle = `rgba(251, 191, 36, ${alpha})`;
          ctx.fillRect(0, y, 1024, 3);
        }
      } else if (biome === 'grassland') {
        // 草原：草絲深淺雜訊
        ctx.fillStyle = '#14532d';
        ctx.fillRect(0, 0, 1024, 1024);
        for (let i = 0; i < 24000; i++) {
          const x = Math.random() * 1024;
          const y = Math.random() * 1024;
          ctx.fillStyle = Math.random() > 0.5 ? '#166534' : '#15803d';
          ctx.fillRect(x, y, 2, 4);
        }
      } else if (biome === 'cyber') {
        // 賽博都市：瀝青雨夜反光與六角網格導線
        ctx.fillStyle = '#090d16';
        ctx.fillRect(0, 0, 1024, 1024);
        ctx.strokeStyle = 'rgba(6, 182, 212, 0.25)';
        ctx.lineWidth = 1.5;
        for (let x = 0; x < 1024; x += 64) {
          ctx.beginPath();
          ctx.moveTo(x, 0); ctx.lineTo(x, 1024);
          ctx.stroke();
        }
        for (let y = 0; y < 1024; y += 64) {
          ctx.beginPath();
          ctx.moveTo(0, y); ctx.lineTo(1024, y);
          ctx.stroke();
        }
      } else if (biome === 'moon') {
        // 月球：粉塵玄武岩與微型隕石坑
        ctx.fillStyle = '#262e3d';
        ctx.fillRect(0, 0, 1024, 1024);
        for (let i = 0; i < 350; i++) {
          const rx = Math.random() * 1024;
          const ry = Math.random() * 1024;
          const r = 2 + Math.random() * 14;
          ctx.beginPath();
          ctx.arc(rx, ry, r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(15, 20, 28, 0.6)';
          ctx.fill();
          ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
          ctx.stroke();
        }
      } else {
        // 實驗室：乾淨無塵室磁磚地磚
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, 1024, 1024);
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.22)';
        ctx.lineWidth = 2;
        for (let i = 0; i <= 1024; i += 128) {
          ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 1024); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(1024, i); ctx.stroke();
        }
      }

      const tex = new THREE.CanvasTexture(cvs);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(30, 30);
      return tex;
    }
    // 地面與跑道擴建至 2000m 級超大型場地，徹底解決飛出場外黑屏問題
    const groundGeo = new THREE.PlaneGeometry(2400, 2400);
    const groundMat = new THREE.MeshStandardMaterial({
      map: generateFloorTexture('lab'),
      roughness: 0.65,
      metalness: 0.1
    });
    const groundMesh = new THREE.Mesh(groundGeo, groundMat);
    groundMesh.rotation.x = -Math.PI / 2;
    groundMesh.receiveShadow = true;
    scene.add(groundMesh);

    // 跑道中心引導光帶 (延伸至 1800m)
    const runwayGeo = new THREE.PlaneGeometry(4.0, 1800);
    const runwayMat = new THREE.MeshBasicMaterial({ color: 0x0284c7, transparent: true, opacity: 0.18, side: THREE.DoubleSide });
    const runwayMesh = new THREE.Mesh(runwayGeo, runwayMat);
    runwayMesh.rotation.x = -Math.PI / 2;
    runwayMesh.position.set(0, 0.005, -890);
    scene.add(runwayMesh);

    /* =========================================================================
       5. 紙飛機 Procedural 折紙模型系統 (尖端嚴格定義在 -Z 前方，機尾在 +Z 後方)
       ========================================================================= */
    const airplaneRoot = new THREE.Group();
    scene.add(airplaneRoot);

    const paperMat = new THREE.MeshStandardMaterial({
      color: 0xf1f5f9,
      roughness: State.roughness,
      metalness: 0.02,
      side: THREE.DoubleSide,
      shadowSide: THREE.DoubleSide
    });

    let wingGroupL = new THREE.Group();
    let wingGroupR = new THREE.Group();
    let elevonMeshL = null;
    let elevonMeshR = null;
    let wingletMeshL = null;
    let wingletMeshR = null;
    const clipMeshes = [];

    function buildOrigamiModel() {
      // 清空舊幾何
      while (airplaneRoot.children.length > 0) {
        airplaneRoot.remove(airplaneRoot.children[0]);
      }
      clipMeshes.length = 0;

      wingGroupL = new THREE.Group();
      wingGroupR = new THREE.Group();
      airplaneRoot.add(wingGroupL);
      airplaneRoot.add(wingGroupR);

      paperMat.roughness = State.roughness;

      // 尖端頂點嚴格位於 -Z 前方 (-0.42)，尾緣在 +Z (+0.18)
      if (State.model === 'dart') {
        // 經典飛鏢號
        const leftGeo = new THREE.BufferGeometry();
        const leftVerts = new Float32Array([
          0, 0, -0.42,   -0.24, 0.02, 0.18,   0, -0.05, 0.18,
          0, 0, -0.42,   0, -0.05, 0.18,       0, 0.01, 0.18
        ]);
        leftGeo.setAttribute('position', new THREE.BufferAttribute(leftVerts, 3));
        leftGeo.computeVertexNormals();
        const leftWing = new THREE.Mesh(leftGeo, paperMat);
        leftWing.castShadow = true; leftWing.receiveShadow = true;
        wingGroupL.add(leftWing);

        const rightGeo = new THREE.BufferGeometry();
        const rightVerts = new Float32Array([
          0, 0, -0.42,   0, -0.05, 0.18,   0.24, 0.02, 0.18,
          0, 0, -0.42,   0, 0.01, 0.18,    0, -0.05, 0.18
        ]);
        rightGeo.setAttribute('position', new THREE.BufferAttribute(rightVerts, 3));
        rightGeo.computeVertexNormals();
        const rightWing = new THREE.Mesh(rightGeo, paperMat);
        rightWing.castShadow = true; rightWing.receiveShadow = true;
        wingGroupR.add(rightWing);

      } else if (State.model === 'glider') {
        // 蘇珊滑翔翼 (大翼展)
        const leftGeo = new THREE.BufferGeometry();
        const leftVerts = new Float32Array([
          0, 0, -0.32,   -0.42, 0.03, 0.12,   0, -0.04, 0.15,
          0, 0, -0.32,   0, -0.04, 0.15,      0, 0.01, 0.15
        ]);
        leftGeo.setAttribute('position', new THREE.BufferAttribute(leftVerts, 3));
        leftGeo.computeVertexNormals();
        const leftWing = new THREE.Mesh(leftGeo, paperMat);
        leftWing.castShadow = true; wingGroupL.add(leftWing);

        const rightGeo = new THREE.BufferGeometry();
        const rightVerts = new Float32Array([
          0, 0, -0.32,   0, -0.04, 0.15,   0.42, 0.03, 0.12,
          0, 0, -0.32,   0, 0.01, 0.15,    0, -0.04, 0.15
        ]);
        rightGeo.setAttribute('position', new THREE.BufferAttribute(rightVerts, 3));
        rightGeo.computeVertexNormals();
        const rightWing = new THREE.Mesh(rightGeo, paperMat);
        rightWing.castShadow = true; wingGroupR.add(rightWing);

      } else if (State.model === 'falcon') {
        // 獵鷹後掠型
        const leftGeo = new THREE.BufferGeometry();
        const leftVerts = new Float32Array([
          0, 0, -0.46,   -0.20, 0.02, 0.22,   0, -0.06, 0.16,
          0, 0, -0.46,   0, -0.06, 0.16,      0, 0.02, 0.16
        ]);
        leftGeo.setAttribute('position', new THREE.BufferAttribute(leftVerts, 3));
        leftGeo.computeVertexNormals();
        const leftWing = new THREE.Mesh(leftGeo, paperMat);
        leftWing.castShadow = true; wingGroupL.add(leftWing);

        const rightGeo = new THREE.BufferGeometry();
        const rightVerts = new Float32Array([
          0, 0, -0.46,   0, -0.06, 0.16,   0.20, 0.02, 0.22,
          0, 0, -0.46,   0, 0.02, 0.16,    0, -0.06, 0.16
        ]);
        rightGeo.setAttribute('position', new THREE.BufferAttribute(rightVerts, 3));
        rightGeo.computeVertexNormals();
        const rightWing = new THREE.Mesh(rightGeo, paperMat);
        rightWing.castShadow = true; wingGroupR.add(rightWing);

      } else {
        // 太空梭鈍形厚翼
        const leftGeo = new THREE.BufferGeometry();
        const leftVerts = new Float32Array([
          0, 0, -0.28,   -0.30, 0.02, 0.15,   0, -0.07, 0.15,
          0, 0, -0.28,   0, -0.07, 0.15,      0, 0.03, 0.15
        ]);
        leftGeo.setAttribute('position', new THREE.BufferAttribute(leftVerts, 3));
        leftGeo.computeVertexNormals();
        const leftWing = new THREE.Mesh(leftGeo, paperMat);
        leftWing.castShadow = true; wingGroupL.add(leftWing);

        const rightGeo = new THREE.BufferGeometry();
        const rightVerts = new Float32Array([
          0, 0, -0.28,   0, -0.07, 0.15,   0.30, 0.02, 0.15,
          0, 0, -0.28,   0, 0.03, 0.15,    0, -0.07, 0.15
        ]);
        rightGeo.setAttribute('position', new THREE.BufferAttribute(rightVerts, 3));
        rightGeo.computeVertexNormals();
        const rightWing = new THREE.Mesh(rightGeo, paperMat);
        rightWing.castShadow = true; wingGroupR.add(rightWing);
      }

      // 尾部可動升降舵片 (Elevons)
      const elevonGeo = new THREE.PlaneGeometry(0.12, 0.04);
      elevonGeo.rotateX(-Math.PI / 2);
      elevonMeshL = new THREE.Mesh(elevonGeo, paperMat);
      elevonMeshR = new THREE.Mesh(elevonGeo, paperMat);
      elevonMeshL.position.set(-0.14, 0.02, 0.18);
      elevonMeshR.position.set(0.14, 0.02, 0.18);
      wingGroupL.add(elevonMeshL);
      wingGroupR.add(elevonMeshR);

      // 翼尖小翼 (Winglets)
      const wingletGeo = new THREE.PlaneGeometry(0.06, 0.08);
      wingletGeo.rotateY(Math.PI / 2);
      wingletMeshL = new THREE.Mesh(wingletGeo, paperMat);
      wingletMeshR = new THREE.Mesh(wingletGeo, paperMat);
      wingletMeshL.position.set(-0.24, 0.04, 0.16);
      wingletMeshR.position.set(0.24, 0.04, 0.16);
      wingGroupL.add(wingletMeshL);
      wingGroupR.add(wingletMeshR);

      // 金屬迴紋針 (Nose Clips 位於 -Z 機首)
      const clipMat = new THREE.MeshStandardMaterial({
        color: 0xd4d4d8,
        metalness: 0.95,
        roughness: 0.18
      });
      for (let i = 0; i < 5; i++) {
        const clipGroup = new THREE.Group();
        const torus = new THREE.Mesh(new THREE.TorusGeometry(0.012, 0.003, 8, 24), clipMat);
        torus.rotation.x = Math.PI / 2;
        clipGroup.add(torus);
        clipGroup.position.set(0, -0.015 - i * 0.003, -0.38 + i * 0.015);
        clipGroup.visible = i < State.clipCount;
        airplaneRoot.add(clipGroup);
        clipMeshes.push(clipGroup);
      }

      applyWingAngles();
      updateAirplaneClearance();
    }

    function applyWingAngles() {
      const dRad = THREE.MathUtils.degToRad(State.dihedralAngle);
      wingGroupL.rotation.z = -dRad;
      wingGroupR.rotation.z = dRad;

      const eRad = THREE.MathUtils.degToRad(State.elevonAngle);
      if (elevonMeshL) elevonMeshL.rotation.x = eRad;
      if (elevonMeshR) elevonMeshR.rotation.x = eRad;

      const wRad = THREE.MathUtils.degToRad(State.wingletAngle);
      if (wingletMeshL) wingletMeshL.rotation.z = wRad;
      if (wingletMeshR) wingletMeshR.rotation.z = -wRad;

      airplaneRoot.scale.setScalar(State.planeScale);
    }

    // 計算機體最低幾何點（確保 0.0m 時絕對不穿模地表）
    function computeAirplaneClearanceOffset() {
      const dRad = THREE.MathUtils.degToRad(State.dihedralAngle);
      const spanHalf = 0.24 * State.planeScale;
      let lowestY = -0.06 * State.planeScale; // 機脊龍骨

      if (dRad < 0) {
        const wingDrop = -Math.sin(-dRad) * spanHalf;
        if (wingDrop < lowestY) lowestY = wingDrop;
      }
      if (State.clipCount > 0) {
        const clipDrop = (-0.02 - State.clipCount * 0.004) * State.planeScale;
        if (clipDrop < lowestY) lowestY = clipDrop;
      }
      return -lowestY + 0.005; // 安全餘量 5mm
    }

    function updateAirplaneClearance() {
      if (!State.isFlying && !State.isLanded) {
        const clearance = computeAirplaneClearanceOffset();
        State.pos.y = State.initialAltitude + clearance;
        airplaneRoot.position.copy(State.pos);
        controls.target.set(State.pos.x, State.pos.y, State.pos.z);
      }
    }

    /* =========================================================================
       6. 發射機構系統 (平坦甲板、橡皮筋彈射、氣動導軌)
       ========================================================================= */
    const launcherGroup = new THREE.Group();
    scene.add(launcherGroup);

    let elasticBandMesh = null;
    let platformDeckMesh = null;
    let elevatorColumn = null;

    function buildLauncher() {
      while (launcherGroup.children.length > 0) {
        launcherGroup.remove(launcherGroup.children[0]);
      }
      launcherGroup.visible = State.enableLauncher;
      if (!State.enableLauncher) return;

      const alt = State.initialAltitude;

      if (State.launcherType === 'slingshot') {
        // 橡皮筋彈射架 (雙立柱 + 彈性繩)
        const frameMat = new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.8, roughness: 0.3 });
        const postGeo = new THREE.CylinderGeometry(0.025, 0.03, 0.35, 16);
        const postL = new THREE.Mesh(postGeo, frameMat);
        const postR = new THREE.Mesh(postGeo, frameMat);
        postL.position.set(-0.25, alt + 0.1, -0.1);
        postR.position.set(0.25, alt + 0.1, -0.1);
        launcherGroup.add(postL);
        launcherGroup.add(postR);

        // 橡皮筋動態繩
        const bandGeo = new THREE.BoxGeometry(0.5, 0.015, 0.02);
        const bandMat = new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.4 });
        elasticBandMesh = new THREE.Mesh(bandGeo, bandMat);
        elasticBandMesh.position.set(0, alt + 0.18, -0.1);
        launcherGroup.add(elasticBandMesh);

      } else if (State.launcherType === 'deck') {
        // 平坦升降甲板 (升降柱嚴格位於甲板下方，0.0m 時完全隱藏)
        const deckGeo = new THREE.BoxGeometry(1.2, 0.04, 1.4);
        const deckMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.5, roughness: 0.4 });
        platformDeckMesh = new THREE.Mesh(deckGeo, deckMat);
        platformDeckMesh.position.set(0, alt - 0.02, 0);
        launcherGroup.add(platformDeckMesh);

        if (alt > 0.05) {
          const colGeo = new THREE.CylinderGeometry(0.08, 0.1, alt, 24);
          const colMat = new THREE.MeshStandardMaterial({ color: 0x475569, metalness: 0.7, roughness: 0.3 });
          elevatorColumn = new THREE.Mesh(colGeo, colMat);
          elevatorColumn.position.set(0, alt / 2 - 0.04, 0);
          launcherGroup.add(elevatorColumn);
        }
      } else {
        // 氣動導軌
        const railMat = new THREE.MeshStandardMaterial({ color: 0x0284c7, metalness: 0.85, roughness: 0.2 });
        const railGeo = new THREE.BoxGeometry(0.03, 0.03, 1.6);
        const railL = new THREE.Mesh(railGeo, railMat);
        const railR = new THREE.Mesh(railGeo, railMat);
        railL.position.set(-0.12, alt - 0.01, 0);
        railR.position.set(0.12, alt - 0.01, 0);
        launcherGroup.add(railL);
        launcherGroup.add(railR);
      }
    }

    /* =========================================================================
       7. 豐富生態地貌實體生成器 (還原各場景多種複合真實 3D 物件，絕非單純球體)
       ========================================================================= */
    const biomeGroup = new THREE.Group();
    scene.add(biomeGroup);

    // 動態旋轉物件列表 (風扇、風車等)
    const dynamicAnimObjects = [];

    function buildBiomeEnvironment() {
      while (biomeGroup.children.length > 0) {
        biomeGroup.remove(biomeGroup.children[0]);
      }
      dynamicAnimObjects.length = 0;

      groundMat.map = generateFloorTexture(State.biome);
      groundMat.needsUpdate = true;

      // 依生態更新重力與大氣密度
      if (State.biome === 'moon') {
        State.gravity = -1.62;
        State.airDensity = 0.0; // 月球為真近真空環境，無升力無空氣阻力
        scene.background.set(0x010307);
        scene.fog.color.set(0x010307);
        scene.fog.density = 0.00015;
      } else if (State.biome === 'desert') {
        State.gravity = -9.81;
        State.airDensity = 1.15;
        scene.background.set(0x451a03);
        scene.fog.color.set(0x451a03);
        scene.fog.density = 0.0035;
      } else if (State.biome === 'grassland') {
        State.gravity = -9.81;
        State.airDensity = 1.225;
        scene.background.set(0x082f49);
        scene.fog.color.set(0x082f49);
        scene.fog.density = 0.0025;
      } else if (State.biome === 'cyber') {
        State.gravity = -9.81;
        State.airDensity = 1.24;
        scene.background.set(0x020617);
        scene.fog.color.set(0x020617);
        scene.fog.density = 0.0035;
      } else {
        // lab
        State.gravity = -9.81;
        State.airDensity = 1.225;
        scene.background.set(0x060c18);
        scene.fog.color.set(0x060c18);
        scene.fog.density = 0.0025;
      }

      // 生成 120+ 個沿長程航道散佈的 3D 複合實體 (深度延伸至 650m)
      const count = State.biome === 'moon' ? 140 : 95;
      for (let i = 0; i < count; i++) {
        const side = Math.random() > 0.5 ? 1 : -1;
        const x = side * (6.0 + Math.random() * 85);
        const z = 30 - Math.random() * 700;
        const variant = Math.random();

        // ----------------------------------------------------
        // 場景 1：高科技實驗室 (Lab)
        // ----------------------------------------------------
        if (State.biome === 'lab') {
          if (variant < 0.22) {
            // 物件 1: 巨型風洞渦輪機 (圓筒外殼 + 軸心 + 動態旋轉扇葉)
            const fanGroup = new THREE.Group();
            const casing = new THREE.Mesh(
              new THREE.CylinderGeometry(1.8, 1.8, 0.8, 24, 1, true),
              new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.8, roughness: 0.2, side: THREE.DoubleSide })
            );
            casing.rotation.x = Math.PI / 2;
            casing.position.y = 2.2;
            fanGroup.add(casing);

            const hub = new THREE.Mesh(
              new THREE.SphereGeometry(0.35, 16, 16),
              new THREE.MeshStandardMaterial({ color: 0x0284c7, metalness: 0.9, roughness: 0.2 })
            );
            hub.position.y = 2.2;
            fanGroup.add(hub);

            // 旋轉葉片
            const bladesPivot = new THREE.Group();
            bladesPivot.position.y = 2.2;
            for (let b = 0; b < 6; b++) {
              const blade = new THREE.Mesh(
                new THREE.ConeGeometry(0.2, 1.4, 6),
                new THREE.MeshStandardMaterial({ color: 0x64748b, metalness: 0.7, roughness: 0.3 })
              );
              blade.rotation.z = (b * Math.PI) / 3;
              blade.position.y = 0.65 * Math.cos((b * Math.PI) / 3);
              blade.position.x = 0.65 * Math.sin((b * Math.PI) / 3);
              bladesPivot.add(blade);
            }
            fanGroup.add(bladesPivot);
            dynamicAnimObjects.push({ obj: bladesPivot, axis: 'z', speed: 2.8 });

            // 底座雙支架
            const legGeo = new THREE.CylinderGeometry(0.1, 0.14, 2.2, 8);
            const legMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.8 });
            const legL = new THREE.Mesh(legGeo, legMat);
            const legR = new THREE.Mesh(legGeo, legMat);
            legL.position.set(-0.9, 1.1, 0);
            legR.position.set(0.9, 1.1, 0);
            fanGroup.add(legL); fanGroup.add(legR);

            fanGroup.position.set(x, 0, z);
            biomeGroup.add(fanGroup);

          } else if (variant < 0.45) {
            // 物件 2: 圓柱型伺服計算機櫃 (含呼吸光環與頂部散熱扇網)
            const serverGroup = new THREE.Group();
            const body = new THREE.Mesh(
              new THREE.CylinderGeometry(0.65, 0.7, 3.2, 18),
              new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.85, roughness: 0.25 })
            );
            body.position.y = 1.6;
            body.castShadow = true;
            serverGroup.add(body);

            // 霓虹發光指示燈環 (2層)
            for (let r = 0; r < 2; r++) {
              const ring = new THREE.Mesh(
                new THREE.TorusGeometry(0.68, 0.035, 8, 24),
                new THREE.MeshBasicMaterial({ color: r === 0 ? 0x38bdf8 : 0x06b6d4 })
              );
              ring.rotation.x = Math.PI / 2;
              ring.position.y = 1.0 + r * 1.2;
              serverGroup.add(ring);
            }
            serverGroup.position.set(x, 0, z);
            biomeGroup.add(serverGroup);

          } else if (variant < 0.65) {
            // 物件 3: 液態氮高壓雙封頭儲氣罐 (圓柱罐身 + 頂部半球頭 + 三角底座)
            const tankGroup = new THREE.Group();
            const cylinder = new THREE.Mesh(
              new THREE.CylinderGeometry(0.85, 0.85, 2.4, 20),
              new THREE.MeshStandardMaterial({ color: 0x475569, metalness: 0.9, roughness: 0.2 })
            );
            cylinder.position.y = 1.7;
            tankGroup.add(cylinder);

            const dome = new THREE.Mesh(
              new THREE.SphereGeometry(0.85, 20, 12, 0, Math.PI * 2, 0, Math.PI / 2),
              new THREE.MeshStandardMaterial({ color: 0x64748b, metalness: 0.9, roughness: 0.2 })
            );
            dome.position.y = 2.9;
            tankGroup.add(dome);

            // 壓力表與閥門
            const gauge = new THREE.Mesh(
              new THREE.CylinderGeometry(0.16, 0.16, 0.08, 16),
              new THREE.MeshStandardMaterial({ color: 0xe2e8f0, metalness: 0.9 })
            );
            gauge.rotation.z = Math.PI / 2;
            gauge.position.set(0.9, 2.2, 0);
            tankGroup.add(gauge);

            tankGroup.position.set(x, 0, z);
            biomeGroup.add(tankGroup);

          } else if (variant < 0.85) {
            // 物件 4: 光學雷射測距校準儀 (三腳架 + 旋轉量測探頭)
            const tripodGroup = new THREE.Group();
            const poleGeo = new THREE.CylinderGeometry(0.04, 0.06, 1.8, 8);
            const tripodMat = new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.7 });
            for (let leg = 0; leg < 3; leg++) {
              const p = new THREE.Mesh(poleGeo, tripodMat);
              p.position.y = 0.85;
              p.rotation.z = 0.25;
              p.rotation.y = (leg * Math.PI * 2) / 3;
              tripodGroup.add(p);
            }
            const head = new THREE.Mesh(
              new THREE.CylinderGeometry(0.18, 0.22, 0.35, 12),
              new THREE.MeshStandardMaterial({ color: 0xf59e0b, metalness: 0.5, roughness: 0.3 })
            );
            head.position.y = 1.85;
            tripodGroup.add(head);

            tripodGroup.position.set(x, 0, z);
            biomeGroup.add(tripodGroup);

          } else {
            // 物件 5: 圓錐形安全防撞警示錐
            const cone = new THREE.Mesh(
              new THREE.ConeGeometry(0.32, 0.9, 16),
              new THREE.MeshStandardMaterial({ color: 0xf97316, roughness: 0.4 })
            );
            cone.position.set(x, 0.45, z);
            cone.castShadow = true;
            biomeGroup.add(cone);
          }

        // ----------------------------------------------------
        // 場景 2：烈日荒漠 (Desert)
        // ----------------------------------------------------
        } else if (State.biome === 'desert') {
          if (variant < 0.35) {
            // 物件 1: 多臂分叉巨型仙人掌 (主幹 + 2 隻向上彎曲的側枝)
            const cGroup = new THREE.Group();
            const cMat = new THREE.MeshStandardMaterial({ color: 0x15803d, roughness: 0.85 });
            const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.26, 3.6, 12), cMat);
            trunk.position.y = 1.8;
            trunk.castShadow = true;
            cGroup.add(trunk);

            // 左側支臂 (水平段 + 垂直段)
            const armL1 = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 0.7, 10), cMat);
            armL1.rotation.z = Math.PI / 2;
            armL1.position.set(-0.45, 2.0, 0);
            const armL2 = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 1.1, 10), cMat);
            armL2.position.set(-0.8, 2.45, 0);
            cGroup.add(armL1); cGroup.add(armL2);

            // 右側支臂
            const armR1 = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.13, 0.6, 10), cMat);
            armR1.rotation.z = Math.PI / 2;
            armR1.position.set(0.4, 1.4, 0);
            const armR2 = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.13, 0.9, 10), cMat);
            armR2.position.set(0.7, 1.75, 0);
            cGroup.add(armR1); cGroup.add(armR2);

            cGroup.position.set(x, 0, z);
            biomeGroup.add(cGroup);

          } else if (variant < 0.65) {
            // 物件 2: 風化疊石石柱 (Hoodoo 岩柱：大中小的多面體堆疊)
            const stackGroup = new THREE.Group();
            const rockMat = new THREE.MeshStandardMaterial({ color: 0x9a3412, roughness: 0.95 });
            const b1 = new THREE.Mesh(new THREE.DodecahedronGeometry(1.4), rockMat);
            b1.position.y = 0.9;
            const b2 = new THREE.Mesh(new THREE.DodecahedronGeometry(0.95), rockMat);
            b2.position.y = 2.2;
            const b3 = new THREE.Mesh(new THREE.DodecahedronGeometry(0.55), rockMat);
            b3.position.y = 3.2;
            stackGroup.add(b1); stackGroup.add(b2); stackGroup.add(b3);
            stackGroup.position.set(x, 0, z);
            biomeGroup.add(stackGroup);

          } else if (variant < 0.85) {
            // 物件 3: 侵蝕波浪沙丘 (平緩低矮圓頂沙堆)
            const dune = new THREE.Mesh(
              new THREE.ConeGeometry(3.5 + Math.random() * 2, 1.2, 16),
              new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.95 })
            );
            dune.position.set(x, 0.6, z);
            biomeGroup.add(dune);

          } else {
            // 物件 4: 乾枯荒漠灌木 (多角度交錯小枝幹)
            const shrub = new THREE.Mesh(
              new THREE.IcosahedronGeometry(0.65 + Math.random() * 0.4, 1),
              new THREE.MeshStandardMaterial({ color: 0x78350f, wireframe: true })
            );
            shrub.position.set(x, 0.45, z);
            biomeGroup.add(shrub);
          }

        // ----------------------------------------------------
        // 場景 3：高原草原 (Grassland)
