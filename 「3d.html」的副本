<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>3D 紙飛機物理模擬實驗室</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- OrbitControls CDN -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <!-- GLTFLoader & OBJLoader CDN -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/OBJLoader.js"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      user-select: none;
      background-color: #030712;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    canvas#webgl-canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      outline: none;
    }
    /* 自訂滾動條 */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(56, 189, 248, 0.4);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(56, 189, 248, 0.7);
    }
    .glass-panel {
      background: rgba(15, 23, 42, 0.82);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(56, 189, 248, 0.18);
    }
    .glass-sub {
      background: rgba(30, 41, 59, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glow-cyan {
      box-shadow: 0 0 20px -3px rgba(6, 182, 212, 0.45);
    }
    .glow-emerald {
      box-shadow: 0 0 22px -3px rgba(16, 185, 129, 0.5);
    }
  </style>
</head>
<body class="text-slate-100 antialiased h-screen w-screen overflow-hidden">

  <!-- 3D WebGL Canvas -->
  <canvas id="webgl-canvas" class="absolute inset-0 z-0"></canvas>

  <!-- 頂部精簡導航與主要快捷列 -->
  <header class="absolute top-3 left-3 right-3 z-20 flex items-center justify-between pointer-events-none">
    <div class="glass-panel px-4 py-2.5 rounded-2xl flex items-center space-x-3 pointer-events-auto shadow-2xl">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/30">
        <i data-lucide="send" class="w-5 h-5 text-white transform -rotate-45"></i>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <span class="font-black text-sm tracking-wide bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-300 bg-clip-text text-transparent">3D 紙飛機物理模擬實驗室</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">AERO V5.0 HIGH-SPEED</span>
        </div>
        <p id="status-indicator" class="text-xs text-slate-400 font-medium">準備發射 | 調整參數後按空白鍵或發射鈕</p>
      </div>
    </div>

    <!-- 頂部視角控制按鈕群 -->
    <div class="glass-panel p-1.5 rounded-2xl flex items-center space-x-1 pointer-events-auto shadow-2xl">
      <button id="cam-chase" class="px-3 py-1.5 rounded-xl text-xs font-medium flex items-center space-x-1.5 transition-all bg-cyan-500/20 text-cyan-300 border border-cyan-500/40" title="動態追逐視角 (發射時自動跟隨)">
        <i data-lucide="video" class="w-3.5 h-3.5"></i>
        <span>動態跟隨</span>
      </button>
      <button id="cam-side" class="px-3 py-1.5 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 flex items-center space-x-1.5 transition-all" title="側面觀測 (檢視俯仰與滑翔攻角)">
        <i data-lucide="scan" class="w-3.5 h-3.5"></i>
        <span>側面觀測</span>
      </button>
      <button id="cam-orbit" class="px-3 py-1.5 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 flex items-center space-x-1.5 transition-all" title="自由 360° 滑鼠拖曳環繞 (無死角)">
        <i data-lucide="rotate-3d" class="w-3.5 h-3.5"></i>
        <span>自由環繞</span>
      </button>
      <div class="h-4 w-px bg-slate-700 mx-1"></div>
      <button id="btn-launch-top" class="px-4 py-1.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 shadow-lg shadow-emerald-500/30 flex items-center space-x-1.5 transition-all pointer-events-auto">
        <i data-lucide="navigation" class="w-3.5 h-3.5 fill-current"></i>
        <span>發射紙飛機</span>
      </button>
      <button id="btn-reset-top" class="p-1.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all" title="重置停靠">
        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
      </button>
    </div>
  </header>

  <!-- 右上角：飛行即時遙測儀 (Telemetry HUD) -->
  <aside class="absolute top-16 right-3 z-20 w-64 glass-panel p-3.5 rounded-2xl shadow-2xl space-y-2 pointer-events-auto">
    <div class="flex items-center justify-between border-b border-slate-700/60 pb-2">
      <div class="flex items-center space-x-1.5 text-xs font-bold text-emerald-400">
        <i data-lucide="activity" class="w-3.5 h-3.5"></i>
        <span>飛行即時遙測儀</span>
      </div>
      <span id="hud-flight-state" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-mono">停靠待命</span>
    </div>

    <div class="grid grid-cols-2 gap-2 text-xs font-mono">
      <div class="glass-sub p-2 rounded-xl">
        <div class="text-[10px] text-slate-400">前向速度 (V)</div>
        <div id="hud-speed" class="text-base font-bold text-emerald-400">0.0 m/s</div>
      </div>
      <div class="glass-sub p-2 rounded-xl">
        <div class="text-[10px] text-slate-400">飛行高度 (Alt)</div>
        <div id="hud-alt" class="text-base font-bold text-sky-400">1.6 m</div>
      </div>
      <div class="glass-sub p-2 rounded-xl">
        <div class="text-[10px] text-slate-400">滑翔航程 (Dist)</div>
        <div id="hud-dist" class="text-base font-bold text-amber-400">0.0 m</div>
      </div>
      <div class="glass-sub p-2 rounded-xl">
        <div class="text-[10px] text-slate-400">迎風攻角 (AoA)</div>
        <div id="hud-aoa" class="text-base font-bold text-cyan-400">+0.0°</div>
      </div>
    </div>

    <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1 border-t border-slate-800">
      <span>空氣動力滑降比 (L/D):</span>
      <span id="hud-ld" class="font-mono font-bold text-slate-200">0.0 : 1</span>
    </div>
  </aside>

  <!-- 左側：多功能實驗室控制面板 (Tab 式分類) -->
  <main class="absolute top-16 left-3 bottom-3 z-20 w-80 glass-panel rounded-2xl shadow-2xl flex flex-col pointer-events-auto overflow-hidden">
    <!-- 面板導航標籤列 -->
    <nav class="flex border-b border-slate-800 bg-slate-900/60 p-1 gap-1">
      <button data-tab="tab-plane" class="tab-btn flex-1 py-1.5 rounded-xl text-xs font-bold text-cyan-300 bg-slate-800/90 flex items-center justify-center space-x-1 transition-all">
        <i data-lucide="paperclip" class="w-3.5 h-3.5"></i>
        <span>機身調校</span>
      </button>
      <button data-tab="tab-launcher" class="tab-btn flex-1 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition-all">
        <i data-lucide="zap" class="w-3.5 h-3.5"></i>
        <span>發射機構</span>
      </button>
      <button data-tab="tab-biome" class="tab-btn flex-1 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition-all">
        <i data-lucide="mountain-snow" class="w-3.5 h-3.5"></i>
        <span>生態環境</span>
      </button>
      <button data-tab="tab-import" class="tab-btn flex-1 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition-all">
        <i data-lucide="box" class="w-3.5 h-3.5"></i>
        <span>匯入模型</span>
      </button>
    </nav>

    <!-- 標籤內容容器 (具備滾動) -->
    <div class="flex-1 overflow-y-auto p-3.5 space-y-4">

      <!-- ================= 標籤 1：機身調校 ================= -->
      <section id="tab-plane" class="tab-pane space-y-3.5">
        <!-- 機型選擇 -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-slate-300 flex items-center gap-1.5">
              <i data-lucide="file-text" class="w-3.5 h-3.5 text-cyan-400"></i>紙飛機折紙型號
            </span>
            <button id="focus-overview" class="text-[11px] text-cyan-400 hover:underline flex items-center gap-0.5">
              <i data-lucide="search" class="w-3 h-3"></i>全貌特寫
            </button>
          </div>
          <div class="grid grid-cols-2 gap-1.5">
            <button data-model="dart" class="model-select-btn p-2 rounded-xl text-left border border-cyan-500/50 bg-cyan-950/30 text-cyan-300">
              <div class="text-xs font-bold">經典飛鏢號</div>
              <div class="text-[10px] text-slate-400">Classic Dart · 高速破空</div>
            </button>
            <button data-model="glider" class="model-select-btn p-2 rounded-xl text-left border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">
              <div class="text-xs font-bold">蘇珊滑翔翼</div>
              <div class="text-[10px] text-slate-400">Suzanne · 寬翼長留空</div>
            </button>
            <button data-model="falcon" class="model-select-btn p-2 rounded-xl text-left border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">
              <div class="text-xs font-bold">獵鷹後掠型</div>
              <div class="text-[10px] text-slate-400">Falcon · 穿透防側滑</div>
            </button>
            <button data-model="shuttle" class="model-select-btn p-2 rounded-xl text-left border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">
              <div class="text-xs font-bold">太空梭型</div>
              <div class="text-[10px] text-slate-400">Shuttle · 巨大阻力減速</div>
            </button>
          </div>
        </div>

        <!-- 迴紋針鼻端配重 -->
        <div class="glass-sub p-2.5 rounded-xl space-y-2">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-amber-300 flex items-center gap-1.5">
              <i data-lucide="paperclip" class="w-3.5 h-3.5"></i>機首配重迴紋針
            </span>
            <button id="focus-nose" class="text-[11px] text-cyan-400 hover:underline flex items-center gap-0.5">
              <i data-lucide="search" class="w-3 h-3"></i>機首特寫
            </button>
          </div>
          <div class="grid grid-cols-6 gap-1">
            <button data-clips="0" class="clip-btn py-1 rounded-lg text-xs font-bold border border-amber-500 bg-amber-500/20 text-amber-300">0枚</button>
            <button data-clips="1" class="clip-btn py-1 rounded-lg text-xs font-medium border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">1枚</button>
            <button data-clips="2" class="clip-btn py-1 rounded-lg text-xs font-medium border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">2枚</button>
            <button data-clips="3" class="clip-btn py-1 rounded-lg text-xs font-medium border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">3枚</button>
            <button data-clips="4" class="clip-btn py-1 rounded-lg text-xs font-medium border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">4枚</button>
            <button data-clips="5" class="clip-btn py-1 rounded-lg text-xs font-medium border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">5枚</button>
          </div>
          <div class="flex justify-between text-[11px] text-slate-400 font-mono">
            <span>附加重量: <b id="val-clip-weight" class="text-amber-300 font-normal">0.0g</b></span>
            <span>靜態俯仰裕度: <b id="val-clip-margin" class="text-emerald-400 font-normal">+11%</b></span>
          </div>
        </div>

        <!-- 升降舵尾舵偏角 -->
        <div class="glass-sub p-2.5 rounded-xl space-y-1.5">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-cyan-300 flex items-center gap-1.5">
              <i data-lucide="sliders" class="w-3.5 h-3.5"></i>升降尾舵偏角 (Elevons)
            </span>
            <button id="focus-tail" class="text-[11px] text-cyan-400 hover:underline flex items-center gap-0.5">
              <i data-lucide="search" class="w-3 h-3"></i>尾舵特寫
            </button>
          </div>
          <div class="flex items-center space-x-2">
            <input type="range" id="slider-elevon" min="-10" max="15" step="1" value="2" class="w-full accent-cyan-400 h-1.5 bg-slate-700 rounded-lg cursor-pointer">
            <span id="val-elevon" class="text-xs font-mono font-bold text-cyan-300 w-10 text-right">+2°</span>
          </div>
          <p class="text-[10px] text-slate-400">微幅向上折起提供配平抬頭力矩；若拉到最大將造成氣流嚴重分離失速阻滯！</p>
        </div>

        <!-- 機翼上反角 -->
        <div class="glass-sub p-2.5 rounded-xl space-y-1.5">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-indigo-300 flex items-center gap-1.5">
              <i data-lucide="triangle" class="w-3.5 h-3.5"></i>機翼上反角 (Dihedral)
            </span>
            <button id="focus-front" class="text-[11px] text-cyan-400 hover:underline flex items-center gap-0.5">
              <i data-lucide="search" class="w-3 h-3"></i>正面特寫
            </button>
          </div>
          <div class="flex items-center space-x-2">
            <input type="range" id="slider-dihedral" min="-10" max="25" step="1" value="6" class="w-full accent-indigo-400 h-1.5 bg-slate-700 rounded-lg cursor-pointer">
            <span id="val-dihedral" class="text-xs font-mono font-bold text-indigo-300 w-10 text-right">+6°</span>
          </div>
        </div>

        <!-- 翼尖小翼 -->
        <div class="glass-sub p-2.5 rounded-xl space-y-1.5">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-pink-300 flex items-center gap-1.5">
              <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>翼尖小翼 (Winglets)
            </span>
            <button id="focus-wingtip" class="text-[11px] text-cyan-400 hover:underline flex items-center gap-0.5">
              <i data-lucide="search" class="w-3 h-3"></i>翼尖特寫
            </button>
          </div>
          <div class="flex items-center space-x-2">
            <input type="range" id="slider-winglet" min="0" max="80" step="5" value="25" class="w-full accent-pink-400 h-1.5 bg-slate-700 rounded-lg cursor-pointer">
            <span id="val-winglet" class="text-xs font-mono font-bold text-pink-300 w-10 text-right">25°</span>
          </div>
        </div>

        <!-- 骨刀壓痕與表面粗糙度 -->
        <div class="glass-sub p-2.5 rounded-xl space-y-2">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-amber-300 flex items-center gap-1.5">
              <i data-lucide="sparkle" class="w-3.5 h-3.5"></i>骨刀壓痕與物理粗糙度
            </span>
            <button id="btn-crease-anim" class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30 flex items-center gap-1">
              <i data-lucide="play" class="w-3 h-3"></i>執行壓痕動畫
            </button>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between text-[11px] text-slate-300">
              <span>紙張 PBR 粗糙度</span>
              <span id="val-roughness" class="text-amber-300 font-mono">0.65</span>
            </div>
            <input type="range" id="slider-roughness" min="0.10" max="0.95" step="0.05" value="0.65" class="w-full accent-amber-400 h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          </div>
          <div class="space-y-1 pt-1 border-t border-slate-700/60">
            <div class="flex justify-between text-[11px] text-slate-300">
              <span>飛機 3D 顯示尺寸縮放</span>
              <span id="val-scale" class="text-sky-300 font-mono">1.2x</span>
            </div>
            <input type="range" id="slider-scale" min="0.8" max="2.2" step="0.1" value="1.2" class="w-full accent-sky-400 h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          </div>
        </div>
      </section>

      <!-- ================= 標籤 2：發射機構 ================= -->
      <section id="tab-launcher" class="tab-pane hidden space-y-3.5">
        <!-- 發射台總開關 -->
        <div class="glass-sub p-2.5 rounded-xl flex items-center justify-between">
          <div>
            <div class="text-xs font-bold text-slate-200">啟用發射台裝備</div>
            <div class="text-[10px] text-slate-400">關閉時為純人手凌空拋擲模式</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="chk-launcher" class="sr-only peer" checked>
            <div class="w-9 h-5 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>

        <!-- 發射機構樣式 -->
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-300">發射裝置類型</label>
          <div class="grid grid-cols-3 gap-1.5">
            <button data-launcher="slingshot" class="launcher-type-btn p-2 rounded-xl text-center border border-emerald-500/50 bg-emerald-950/30 text-emerald-300">
              <div class="text-xs font-bold">橡皮筋彈射</div>
              <div class="text-[9px] text-slate-400">高彈力衝量加乘</div>
            </button>
            <button data-launcher="deck" class="launcher-type-btn p-2 rounded-xl text-center border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">
              <div class="text-xs font-bold">升降甲板</div>
              <div class="text-[9px] text-slate-400">平坦防穿模跑道</div>
            </button>
            <button data-launcher="rail" class="launcher-type-btn p-2 rounded-xl text-center border border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500">
              <div class="text-xs font-bold">氣動導軌</div>
              <div class="text-[9px] text-slate-400">雙軌精密直線引導</div>
            </button>
          </div>
        </div>

        <!-- 初始高度選擇 -->
        <div class="glass-sub p-2.5 rounded-xl space-y-2">
          <div class="flex justify-between text-xs">
            <span class="font-bold text-sky-300">初始發射高度 (Altitude)</span>
            <span id="val-altitude" class="font-mono text-sky-400 font-bold">1.6 m</span>
          </div>
          <input type="range" id="slider-altitude" min="0.0" max="30.0" step="0.2" value="1.6" class="w-full accent-sky-400 h-1.5 bg-slate-700 rounded-lg cursor-pointer">
          <div class="grid grid-cols-5 gap-1 pt-1">
            <button data-alt="0.0" class="alt-preset-btn py-1 rounded text-[10px] bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">0m地面</button>
            <button data-alt="1.6" class="alt-preset-btn py-1 rounded text-[10px] bg-sky-950/40 text-sky-300 border border-sky-500/50">1.6m人手</button>
            <button data-alt="5.0" class="alt-preset-btn py-1 rounded text-[10px] bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">5m陽台</button>
            <button data-alt="15.0" class="alt-preset-btn py-1 rounded text-[10px] bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">15m頂樓</button>
            <button data-alt="30.0" class="alt-preset-btn py-1 rounded text-[10px] bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700">30m高塔</button>
          </div>
